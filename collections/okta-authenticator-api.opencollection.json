{
  "opencollection": "1.0.0",
  "info": {
    "name": "Okta Application Authenticator API",
    "version": "2.16.0"
  },
  "items": [
    {
      "info": {
        "name": "Authenticator",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Okta Lists all available Authenticators",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://your-subdomain.okta.com/api/v1/authenticators",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "List Authenticators"
        },
        {
          "info": {
            "name": "Okta Create an Authenticator",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://your-subdomain.okta.com/api/v1/authenticators",
            "params": [
              {
                "name": "activate",
                "value": "",
                "type": "query"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Create Authenticator"
        },
        {
          "info": {
            "name": "getAuthenticator",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://your-subdomain.okta.com/api/v1/authenticators/:authenticatorId",
            "params": [
              {
                "name": "authenticatorId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Success"
        },
        {
          "info": {
            "name": "Okta Update Authenticator",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://your-subdomain.okta.com/api/v1/authenticators/:authenticatorId",
            "params": [
              {
                "name": "authenticatorId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Updates an authenticator"
        },
        {
          "info": {
            "name": "activateAuthenticator",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://your-subdomain.okta.com/api/v1/authenticators/:authenticatorId/lifecycle/activate",
            "params": [
              {
                "name": "authenticatorId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Success"
        },
        {
          "info": {
            "name": "deactivateAuthenticator",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://your-subdomain.okta.com/api/v1/authenticators/:authenticatorId/lifecycle/deactivate",
            "params": [
              {
                "name": "authenticatorId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Success"
        }
      ]
    }
  ],
  "bundled": true
}