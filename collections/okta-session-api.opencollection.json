{
  "opencollection": "1.0.0",
  "info": {
    "name": "Okta Application Session API",
    "version": "2.16.0"
  },
  "items": [
    {
      "info": {
        "name": "Session",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Okta Create Session with Session Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://your-subdomain.okta.com/api/v1/sessions",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Creates a new session for a user with a valid session token. Use this API if, for example, you want to set the session cookie yourself instead of allowing Okta to set it, or want to hold the session ID in order to delete a session via the API instead of visiting the logout URL."
        },
        {
          "info": {
            "name": "getSession",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://your-subdomain.okta.com/api/v1/sessions/:sessionId",
            "params": [
              {
                "name": "sessionId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Get details about a session."
        },
        {
          "info": {
            "name": "Okta Close Session",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://your-subdomain.okta.com/api/v1/sessions/:sessionId",
            "params": [
              {
                "name": "sessionId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Okta Close Session"
        },
        {
          "info": {
            "name": "Okta Refresh Session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://your-subdomain.okta.com/api/v1/sessions/:sessionId/lifecycle/refresh",
            "params": [
              {
                "name": "sessionId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Okta Refresh Session"
        }
      ]
    }
  ],
  "bundled": true
}