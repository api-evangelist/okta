        {
          "info": {
            "name": "Opt in all users to Okta Communication emails",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://your-subdomain.okta.com/api/v1/org/privacy/oktaCommunication/optIn",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
