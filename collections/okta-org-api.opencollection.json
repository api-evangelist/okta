          "http": {
            "method": "GET",
            "url": "https://your-subdomain.okta.com/api/v1/org/privacy/oktaCommunication",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
