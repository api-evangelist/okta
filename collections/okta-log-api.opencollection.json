{
  "opencollection": "1.0.0",
  "info": {
    "name": "Okta Application Log API",
    "version": "2.16.0"
  },
  "items": [
    {
      "info": {
        "name": "Log",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch a list of events from your Okta organization system log.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://your-subdomain.okta.com/api/v1/logs",
            "params": [
              {
                "name": "since",
                "value": "",
                "type": "query"
              },
              {
                "name": "until",
                "value": "",
                "type": "query"
              },
              {
                "name": "filter",
                "value": "",
                "type": "query"
              },
              {
                "name": "q",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "sortOrder",
                "value": "",
                "type": "query"
              },
              {
                "name": "after",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "The Okta System Log API provides read access to your organization’s system log. This API provides more functionality than the Events API"
        }
      ]
    }
  ],
  "bundled": true
}